# Copy this file to `infra/terraform.tfvars` (gitignored) and populate values for your GCP project.

project_id  = "interactive-rag"
region      = "us-central1"
app_name    = "interactive-rag"
environment = "prod"
image_tag   = "latest"

# Cloud Run Sizing
backend_cpu          = "2"
backend_memory       = "2Gi"
frontend_cpu         = "1"
frontend_memory      = "512Mi"
min_instance_count   = 0
max_instance_count   = 5
bucket_force_destroy = false

# Identity Platform / Firebase Web Config (auto-populated from Identity Platform if left empty)
firebase_api_key = ""
firebase_app_id  = ""

# Google OAuth Sign-In (credentials loaded dynamically from GCP Secret Manager)
enable_google_oauth                = true
google_oauth_client_id_secret_name = "google_oauth_client_id"
google_oauth_client_secret_name    = "google_oauth_client_secret"
