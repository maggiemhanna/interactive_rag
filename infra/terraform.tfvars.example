# Copy this file to `infra/terraform.tfvars` (gitignored) and populate values for your GCP project.

project_id  = "interactive-rag"
region      = "us-central1"
app_name    = "interactive-rag"
environment = "prod"
image_tag   = "latest"

# Cloud Run Sizing
backend_cpu          = "2"
backend_memory       = "2Gi"
frontend_cpu         = "1"
frontend_memory      = "512Mi"
min_instance_count   = 0
max_instance_count   = 5
bucket_force_destroy = false

# Identity Platform / Firebase Web Config (auto-populated from Identity Platform if left empty)
firebase_api_key = ""
firebase_app_id  = ""

# Google OAuth Sign-In (credentials loaded dynamically from GCP Secret Manager)
enable_google_oauth                = true
google_oauth_client_id_secret_name = "google_oauth_client_id"
google_oauth_client_secret_name    = "google_oauth_client_secret"

# VPC Subnets (Direct VPC Egress for ingestion-api and agent-api + Regional PSC Endpoints)
ingestion_subnet_cidr = "10.10.1.0/26"
agent_subnet_cidr     = "10.10.2.0/26"
psc_subnet_cidr       = "10.10.3.0/28"

# AI-Specific Security (Model Allowlists, Model Armor, Content Safety & Guardrail Ceilings)
allowed_llm_models         = "gemini-3.8-flash,gemini-2.5-flash,gemini-2.5-pro"
allowed_embedding_models   = "gemini-embedding-001,text-embedding-005"
gemini_safety_threshold    = "BLOCK_LOW_AND_ABOVE"
model_armor_pi_confidence  = "MEDIUM_AND_ABOVE"
model_armor_rai_confidence = "MEDIUM_AND_ABOVE"
max_upload_mb              = 20
max_files_per_request      = 10
max_chunks_per_ingest      = 1000
max_query_chars            = 4000
agent_recursion_limit      = 6
