# Local frontend environment variables (copy to `frontend/.env` for local `npm run dev`)
VITE_INGESTION_API_URL=http://localhost:8000
VITE_AGENT_API_URL=http://localhost:8001

# Find Web API Key in GCP Console -> Identity Platform -> Settings -> Application setup details
# (or after `make deploy`, run: `terraform -chdir=infra output -raw firebase_web_api_key`)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=interactive-rag.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=interactive-rag
VITE_FIREBASE_APP_ID=
